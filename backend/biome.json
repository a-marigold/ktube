{
    "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",

    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": false
    },

    "files": {
        "includes": ["**", "!node_modules", "!dist"]
    },

    "formatter": {
        "enabled": false,
        "indentStyle": "tab"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "off"
            }
        }
    }
}
